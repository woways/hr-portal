rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Employees collection — any authenticated user can read/write
    match /employees/{employeeId} {
      allow read, write: if request.auth != null;
    }

    // Attendance — HR can read/write all; employees can read own
    match /attendance/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Leave Requests — employees can create/read/update own; HR can read/write all
    match /leaveRequests/{docId} {
      // Returns the authenticated user's profile document from the users collection
      function userProfile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function userProfileExists() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid));
      }
      // HR admin check: custom claim OR role field in users doc
      function isHRAdmin() {
        return request.auth.token.role == "hr_admin" ||
               (userProfileExists() && userProfile().role == "hr_admin");
      }
      // Employee can only access leave requests where empId matches their own employeeId
      function isOwnLeave(empIdField) {
        return userProfileExists() && userProfile().employeeId == empIdField;
      }
      allow read: if request.auth != null &&
                    (isHRAdmin() || isOwnLeave(resource.data.empId));
      allow create: if request.auth != null &&
                      (isHRAdmin() || isOwnLeave(request.resource.data.empId));
      allow update: if request.auth != null &&
                      (isHRAdmin() ||
                       (isOwnLeave(resource.data.empId) && resource.data.status == "Pending"));
      allow delete: if request.auth != null && isHRAdmin();
    }

    // Candidates — any authenticated user (HR portal is authenticated-only)
    match /candidates/{docId} {
      allow read, write: if request.auth != null;
    }

    // Goals — HR can create/update; employees can read own and update progress
    match /goals/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Payroll — HR can read/write; employees can read own
    match /payroll/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == "hr_admin";
    }

    // Notifications — all authenticated users can read; HR can write
    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Job Postings
    match /jobPostings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == "hr_admin";
    }

    // Compensation — HR can read/write all; employees can read own records
    match /compensation/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Incentives — HR can read/write all; employees can read own
    match /incentives/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Documents — single collection for all employee & HR uploaded documents
    match /documents/{docId} {
      allow read, write: if request.auth != null;
    }

    // Employee dashboard document metadata (employee-dashboard documentService)
    match /employeeDocuments/{docId} {
      allow read, write: if request.auth != null;
    }

    // Regularization requests
    match /regularization/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Clock records
    match /clockRecords/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User profiles — each user can read/write their own; HR admin can read all
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Help & Support queries — employees can read/write their own; HR can read/write all
    match /helpQueries/{docId} {
      allow read, write: if request.auth != null;
    }

    // Settings — any authenticated user can read; any authenticated user can write
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
