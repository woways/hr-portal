rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Company logo
    match /company/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Profile photos — employee can upload their own (both paths)
    match /employeePhotos/{empId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /profile-photos/{empId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Education certificates — employee can upload their own
    match /employeeCertificates/{empId}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Employee documents (PAN, Aadhar, offer letters, etc.) — legacy path
    match /employeeDocuments/{empId}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // New unified documents path
    match /documents/{empId}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Medical proof uploads for leave requests
    match /leaveProofs/{empId}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Help & Support query attachments
    match /helpAttachments/{empId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // HR email composer attachments
    match /emailAttachments/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Candidate resumes (recruitment module)
    match /resumes/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Offer letters (recruitment — Offer Management)
    match /offerLetters/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
